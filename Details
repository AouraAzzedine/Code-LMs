@model CarUdar.Core.Entities.RealEstate

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

}



<style>
    /* ---------- Custom page styling ---------- */
    body {
        background: #f8f9fa;
        font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    }

    .hero {
        background: linear-gradient(135deg, #0062E6, #33AEFF);
        color: #fff;
        padding: 2rem 0;
        text-align: center;
    }

        .hero h1 {
            font-weight: 700;
            margin-bottom: .5rem;
        }

    .price-badge {
        font-size: 1.5rem;
        font-weight: 600;
        background: #ff8c00;
        border-radius: .5rem;
        padding: .3rem .8rem;
        display: inline-block;
    }

    .carousel-img {
        height: 450px;
        object-fit: cover;
    }

    .badge-feature {
        font-size: 0.85rem;
        margin-right: .5rem;
        margin-bottom: .5rem;
    }

    .amenities i {
        width: 1.6rem;
        text-align: center;
    }

    .info-card {
        border: none;
        background: #fff;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

        .info-card .card-body {
            padding: 1rem 1.5rem;
        }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: .75rem;
        border-left: 4px solid #0062E6;
        padding-left: .75rem;
        color: #333;
    }

    .property-details dl {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: .5rem .75rem;
        margin: 0;
    }

    .property-details dt {
        font-weight: 500;
        color: #555;
    }

    .property-details dd {
        margin-left: 0;
        color: #222;
    }

    .description {
        white-space: pre-wrap; /* keep line breaks from description */
    }

    .footer {
        margin-top: 4rem;
        padding: 2rem 0;
        background: #212529;
        color: #ccc;
    }
</style>

<body>

    <!-- ==================== GALLERY (CAROUSEL) ==================== -->
    <section class="container my-4">
        {{#Images}}
        <div id="realEstateCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                {{#Images}}
                <div class="carousel-item {{#first}}active{{/first}}">
                    <img src="{{ImageUrl}}" class="d-block w-100 carousel-img" alt="{{AltText}}">
                </div>
                {{/Images}}
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#realEstateCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#realEstateCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        {{/Images}}
        {{^Images}}
        <div class="text-center py-5 bg-light rounded">
            <i class="fas fa-image fa-3x text-muted"></i>
            <p class="mt-3 text-muted">No images available</p>
        </div>
        {{/Images}}
    </section>

    <!-- ==================== MAIN INFO CARD ==================== -->
    <section class="container">
        <div class="row g-4">

            <!-- LEFT COLUMN – DETAILS -->
            <div class="col-lg-8">
                <!-- Property description -->
                <h2 class="section-title">Description</h2>
                <p class="description">{{Description}}</p>

                <!-- Technical Details -->
                <h2 class="section-title">Property Details</h2>
                <div class="info-card">
                    <div class="card-body property-details">
                        <dl>
                            <dt>Price</dt>
                            <dd>{{Price | currency:"EUR"}}</dd>

                            <dt>Price / m²</dt>
                            <dd>{{PricePerSquareMeter | currency:"EUR"}}/m²</dd>

                            <dt>Area</dt>
                            <dd>{{Area}} m²</dd>

                            <dt>Rooms</dt>
                            <dd>{{Rooms}}</dd>

                            <dt>Bathrooms</dt>
                            <dd>{{Bathrooms}}</dd>

                            <dt>Floor</dt>
                            <dd>{{Floor}}</dd>

                            <dt>Construction Year</dt>
                            <dd>{{ConstructionYear}} ({{Age}} years old)</dd>

                            <dt>Is New Construction?</dt>
                            <dd>{{#IsNewConstruction}}Yes{{/IsNewConstruction}}{{^IsNewConstruction}}No{{/IsNewConstruction}}</dd>

                            <dt>Construction Type</dt>
                            <dd>{{Construction}}</dd>

                            <dt>Energy Class</dt>
                            <dd>{{EnergyClass}}</dd>

                            <dt>Furnishing</dt>
                            <dd>{{Furnishing}}</dd>

                            <dt>Condition</dt>
                            <dd>{{Condition}}</dd>

                            <dt>Availability</dt>
                            <dd>{{#IsAvailable}}Available{{/IsAvailable}}{{^IsAvailable}}From {{AvailabilityDate | date:"dd MMM yyyy"}}{{/IsAvailable}}</dd>

                            <dt>Monthly Charges</dt>
                            <dd>{{#MonthlyCharges}}{{MonthlyCharges | currency:"EUR"}}{{/MonthlyCharges}}{{^MonthlyCharges}}—{{/MonthlyCharges}}</dd>

                            <dt>Security Deposit</dt>
                            <dd>{{#SecurityDeposit}}{{SecurityDeposit | currency:"EUR"}}{{/SecurityDeposit}}{{^SecurityDeposit}}—{{/SecurityDeposit}}</dd>

                            <dt>Total Monthly Cost (Location)</dt>
                            <dd>{{#TransactionType}} {{#lower}}location{{/lower}} {{/TransactionType}} {{#GetTotalMonthlyCost}}{{GetTotalMonthlyCost | currency:"EUR"}}{{/GetTotalMonthlyCost}} {{^GetTotalMonthlyCost}}—{{/GetTotalMonthlyCost}}</dd>

                            <dt>View Count</dt>
                            <dd>{{ViewCount}}</dd>

                            <dt>Featured?</dt>
                            <dd>{{#IsFeatured}}Yes{{/IsFeatured}}{{^IsFeatured}}No{{/IsFeatured}}</dd>

                            <dt>Active?</dt>
                            <dd>{{#IsActive}}Yes{{/IsActive}}{{^IsActive}}No{{/IsActive}}</dd>

                            <dt>Agency Listing?</dt>
                            <dd>{{#IsAgency}}Yes{{/IsAgency}}{{^IsAgency}}No{{/IsAgency}}</dd>
                        </dl>
                    </div>
                </div>

                <!-- Amenities -->
                <h2 class="section-title">Amenities</h2>
                <div class="info-card">
                    <div class="card-body">
                        <div class="row amenities text-center">
                            {{#HasGarden}}  <div class="col-4 col-md-3 mb-3"><i class="fas fa-tree text-success"></i><br>Garden</div> {{/HasGarden}}
                            {{#HasParking}} <div class="col-4 col-md-3 mb-3"><i class="fas fa-parking text-success"></i><br>Parking</div> {{/HasParking}}
                            {{#HasElevator}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-elevator text-success"></i><br>Elevator</div> {{/HasElevator}}
                            {{#HasBalcony}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-archway text-success"></i><br>Balcony</div> {{/HasBalcony}}
                            {{#HasTerrace}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-umbrella-beach text-success"></i><br>Terrace</div> {{/HasTerrace}}
                            {{#HasSwimmingPool}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-water text-success"></i><br>Swimming Pool</div> {{/HasSwimmingPool}}
                            {{#HasPool}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-swimmer text-success"></i><br>Pool</div> {{/HasPool}}
                            {{#HasSecurity}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-shield-alt text-success"></i><br>Security</div> {{/HasSecurity}}
                            {{#IsFurnished}}<div class="col-4 col-md-3 mb-3"><i class="fas fa-couch text-success"></i><br>Furnished</div> {{/IsFurnished}}
                        </div>
                        {{^AnyAmenity}}
                        <p class="text-muted text-center">No special amenities listed.</p>
                        {{/AnyAmenity}}
                    </div>
                </div>

                <!-- Additional Notes -->
                {{#Notes}}
                <h2 class="section-title">Additional Notes</h2>
                <div class="info-card">
                    <div class="card-body">
                        <p>{{Notes}}</p>
                    </div>
                </div>
                {{/Notes}}

                <!-- Custom Features (optional long text) -->
                {{#Features}}
                <h2 class="section-title">Features</h2>
                <div class="info-card">
                    <div class="card-body">
                        <p>{{Features}}</p>
                    </div>
                </div>
                {{/Features}}

            </div>

            <!-- RIGHT COLUMN – QUICK CONTACT -->
            <div class="col-lg-4">
                <div class="info-card sticky-lg-top" style="top:2rem;">
                    <div class="card-body">
                        <h5 class="card-title mb-3"><i class="fas fa-phone-alt me-2"></i>Contact the seller</h5>

                        <!-- Change these placeholders to the method you use (mailto:, tel:, or a form) -->
                        <a href="tel:+{{PhoneNumber}}" class="btn btn-success w-100 mb-2"><i class="fas fa-phone"></i> Call</a>
                        <a href="mailto:{{ContactEmail}}" class="btn btn-primary w-100 mb-2"><i class="fas fa-envelope"></i> Email</a>

                        <hr>

                        <h6 class="mt-3"><i class="fas fa-info-circle me-2"></i>Quick Facts</h6>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Price:</strong> {{Price | currency:"EUR"}}</li>
                            <li><strong>Area:</strong> {{Area}} m²</li>
                            <li><strong>Rooms:</strong> {{Rooms}}</li>
                            <li><strong>Bathrooms:</strong> {{Bathrooms}}</li>
                            <li><strong>Floor:</strong> {{Floor}}</li>
                            <li><strong>Construction Year:</strong> {{ConstructionYear}}</li>
                            {{#IsNewConstruction}}
                            <li class="text-success"><i class="fas fa-star"></i> New Construction</li>{{/IsNewConstruction}}
                        </ul>
                    </div>
                </div>

                <!-- OPTIONAL MAP PLACEHOLDER -->
                <div class="info-card mt-4">
                    <div class="card-body p-0">
                        <div id="map" style="height:250px; background:#e9ecef;">
                            <p class="text-center py-5 text-muted">Map placeholder – integrate with Google / Leaflet</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>






    <br />
    <br />
    <br />
    <br />




