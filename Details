@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Bootstrap 5 JS (popper & bundle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+OGU0l5K/3s5vU8U5v8bM6V5J0p2a"
            crossorigin="anonymous"></script>

    <!-- OPTIONAL: Simple script to replace boolean placeholders with icons (if you aren't using a templating engine) -->
    <script>
        // Example: if you generate the page server‑side you likely won't need this.
        // If you keep the boolean placeholders as "true"/"false" strings, this will turn them into icons.
        document.querySelectorAll('.amenities div').forEach(el => {
            const txt = el.textContent.trim().toLowerCase();
            if (txt === 'true' || txt === 'yes') {
                // already the correct content (we added icons in markup)
            } else {
                // hide empty rows
                if (!txt) el.style.display = 'none';
            }
        });
    </script>



